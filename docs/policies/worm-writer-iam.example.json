{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectLockedBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__"
      ]
    },
    {
      "Sid": "PutLockedObjectsAndInspectRetention",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention",
        "s3:GetObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/__PREFIX__/snapshots/*",
        "arn:aws:s3:::__BUCKET__/__PREFIX__/manifests/*"
      ]
    },
    {
      "Sid": "ReadPinnedManifestOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/__PREFIX__/manifests/*"
      ]
    },
    {
      "Sid": "DenyDestructionAndBucketReconfiguration",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:PutBucketVersioning",
        "s3:PutBucketObjectLockConfiguration",
        "s3:BypassGovernanceRetention",
        "s3:PutObjectLegalHold",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__",
        "arn:aws:s3:::__BUCKET__/*"
      ]
    }
  ]
}
