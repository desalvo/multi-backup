# TEMPLATE ONLY: do not start until secrets and private network are configured.
MULTI_BACKUP_ADMIN_USER=admin
MULTI_BACKUP_ADMIN_HASH_FILE=/etc/multi-backup/secrets/admin-hash
MULTI_BACKUP_PUBLIC_ORIGIN=https://backup.example.org
MULTI_BACKUP_BIND=127.0.0.1:8080
MULTI_BACKUP_HARDENED_MODE=true
MULTI_BACKUP_PRIVATE_GATE_SECRET_FILE=/etc/multi-backup/secrets/gateway
MULTI_BACKUP_RECOVERY_SECRET_FILE=/etc/multi-backup/secrets/offline-recovery
MULTI_BACKUP_DATA_ROOT=/var/lib/multi-backup/data
MULTI_BACKUP_AGE_IDENTITY_FILE=/etc/multi-backup/secrets/age-identity
MULTI_BACKUP_EXPORT_ROOT=/var/lib/multi-backup/exports
MULTI_BACKUP_AUDIT_LOG=/var/log/multi-backup/audit.jsonl
# PostgreSQL exclusively via local HAProxy into private 10.70.0.0/24 VLAN.
# db-ha.internal -> 127.0.0.1, TLS cert has SAN db-ha.internal.
MULTI_BACKUP_CLUSTER_DATABASE_URL=postgresql://multi_backup@db-ha.internal:6432/multi_backup?sslmode=verify-full
MULTI_BACKUP_CLUSTER_TLS_CA_FILE=/etc/multi-backup/secrets/pg-ca.pem
MULTI_BACKUP_REPLICA_ID=SET-UNIQUE-NODE-ID
MULTI_BACKUP_REPLICA_MAX_JOBS=4
MULTI_BACKUP_CLUSTER_STORAGE_IDS=local-SET-UNIQUE-NODE-ID
MULTI_BACKUP_CLUSTER_CATALOG_STORAGE_ID=local-SET-UNIQUE-NODE-ID
MULTI_BACKUP_CLUSTER_EXECUTOR=disabled
# Optional independent S3 Object Lock COMPLIANCE DB backup (>=30 days)
# MULTI_BACKUP_DB_BACKUP_S3_CONFIG=/etc/multi-backup/db-s3-worm.json
MULTI_BACKUP_DB_BACKUP_STAGE_ROOT=/var/lib/multi-backup/db-staging
# Monitoring disabled until enabled explicitly; never expose DB port 5432
MULTI_BACKUP_PROMETHEUS_ENABLED=false
MULTI_BACKUP_PROMETHEUS_BIND=127.0.0.1:9502
# Remote VLAN monitoring requires BOTH bearer token and HTTPS; 0600 secrets.
# MULTI_BACKUP_PROMETHEUS_TOKEN_FILE=/etc/multi-backup/secrets/prometheus-token
# MULTI_BACKUP_PROMETHEUS_TLS_CERT_FILE=/etc/multi-backup/secrets/metrics.crt
# MULTI_BACKUP_PROMETHEUS_TLS_KEY_FILE=/etc/multi-backup/secrets/metrics.key
MULTI_BACKUP_REST_API_ENABLED=false
MULTI_BACKUP_REST_API_BIND=127.0.0.1:8443
# MULTI_BACKUP_REST_TLS_CERT_FILE=/etc/multi-backup/secrets/monitor.crt
# MULTI_BACKUP_REST_TLS_KEY_FILE=/etc/multi-backup/secrets/monitor.key
MULTI_BACKUP_SNMP_ENABLED=false
MULTI_BACKUP_SNMP_BIND=127.0.0.1
MULTI_BACKUP_SNMP_PORT=161
MULTI_BACKUP_SNMP_VERSIONS=3
MULTI_BACKUP_SNMP_COMMUNITY=public

# Per-replica bounded Rust cluster executor. Default 4; valid 1..64.
# At capacity do not claim more PostgreSQL jobs: they remain queued safely.
# Must be <= MULTI_BACKUP_REPLICA_MAX_JOBS; invalid startup is rejected.
MULTI_BACKUP_CLUSTER_MAX_ACTIVE_JOBS=4
