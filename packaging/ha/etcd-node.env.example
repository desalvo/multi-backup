# etcd example for node1 only. Change NAME and IP for node2/node3.
# TLS certificates and private keys supplied by administrator. NEVER listen
# on public interfaces and allow peer connections only from 10.70.0.0/24.
ETCD_NAME=mb-node1
ETCD_DATA_DIR=/var/lib/etcd/multi-backup
ETCD_LISTEN_CLIENT_URLS=https://10.70.0.11:2379
ETCD_ADVERTISE_CLIENT_URLS=https://10.70.0.11:2379
ETCD_LISTEN_PEER_URLS=https://10.70.0.11:2380
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://10.70.0.11:2380
ETCD_INITIAL_CLUSTER=mb-node1=https://10.70.0.11:2380,mb-node2=https://10.70.0.12:2380,mb-node3=https://10.70.0.13:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_CLIENT_CERT_AUTH=true
ETCD_TRUSTED_CA_FILE=/etc/etcd/tls/ca.pem
ETCD_CERT_FILE=/etc/etcd/tls/node.crt
ETCD_KEY_FILE=/etc/etcd/tls/node.key
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_PEER_TRUSTED_CA_FILE=/etc/etcd/tls/ca.pem
ETCD_PEER_CERT_FILE=/etc/etcd/tls/node.crt
ETCD_PEER_KEY_FILE=/etc/etcd/tls/node.key
