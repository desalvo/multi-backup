# TEMPLATE: copy on EACH server, substituting private IP, node name and TLS secret paths.
# Mode 0600; credentials must never be stored in Git. PostgreSQL does NOT listen publicly.
scope: multi-backup
namespace: /multi-backup/
name: mb-node1
restapi:
  listen: 10.70.0.11:8008
  connect_address: 10.70.0.11:8008
  certfile: /etc/patroni/tls/server.crt
  keyfile: /etc/patroni/tls/server.key
  cafile: /etc/patroni/tls/ca.pem
  authentication:
    username: patroni-api
    password: REPLACE_WITH_SEPARATE_SECRET
etcd3:
  hosts: 10.70.0.11:2379,10.70.0.12:2379,10.70.0.13:2379
  protocol: https
  cacert: /etc/patroni/tls/etcd-ca.pem
  cert: /etc/patroni/tls/etcd-client.crt
  key: /etc/patroni/tls/etcd-client.key
bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 0
    synchronous_mode: 'on'
    synchronous_mode_strict: true
    synchronous_node_count: 1
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        max_wal_senders: 16
        max_replication_slots: 16
        wal_keep_size: 1024MB
        hot_standby: 'on'
        synchronous_commit: remote_apply
        ssl: 'on'
        password_encryption: scram-sha-256
  initdb:
    - encoding: UTF8
    - data-checksums
  pg_hba:
    - local all postgres peer
    - hostssl replication repl 10.70.0.0/24 scram-sha-256
    - hostssl all multi_backup 10.70.0.0/24 scram-sha-256
    - hostssl all postgres 10.70.0.0/24 scram-sha-256
  users:
    multi_backup:
      password: REPLACE_WITH_INDEPENDENT_SECRET
      options:
        - createdb
postgresql:
  listen: 10.70.0.11:5432
  connect_address: 10.70.0.11:5432
  data_dir: /var/lib/pgsql/data
  bin_dir: /usr/pgsql-17/bin
  pgpass: /var/lib/patroni/.pgpass
  authentication:
    replication:
      username: repl
      password: REPLACE_WITH_REPLICATION_SECRET
    superuser:
      username: postgres
      password: REPLACE_WITH_POSTGRES_SECRET
    rewind:
      username: rewind
      password: REPLACE_WITH_REWIND_SECRET
  parameters:
    ssl_cert_file: /etc/patroni/tls/postgres.crt
    ssl_key_file: /etc/patroni/tls/postgres.key
    ssl_ca_file: /etc/patroni/tls/ca.pem
  create_replica_methods:
    - basebackup
  basebackup:
    checkpoint: fast
tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
